# Neon PostgreSQL Configuration
# Update these with your Neon database credentials

DB_HOST=your-neon-host.neon.tech
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_PORT=5432

# Example with Neon credentials:
# DB_HOST=ep-silent-dew-12345678.us-east-1.aws.neon.tech
# DB_NAME=setu_db
# DB_USER=setu_user
# DB_PASSWORD=your_secure_password
# DB_PORT=5432

# Note: SSL is automatically enabled (sslmode="require")

